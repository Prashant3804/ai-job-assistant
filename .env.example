# ==============================================================================
# AI JOB ASSISTANT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate all required secrets before starting in production mode.
# 3. DO NOT commit .env with real secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC CLIENT VARIABLES (Exposed to Next.js Frontend Browser Bundle)
# ==============================================================================
# Public application domain for the frontend
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"

# Public backend API endpoint
NEXT_PUBLIC_API_URL="https://api.yourdomain.com/api/v1"


# ==============================================================================
# 2. PRIVATE SERVER VARIABLES (Backend & Background Worker Only)
# ==============================================================================

# Project & Runtime
PROJECT_NAME="AI Job Assistant API"
VERSION="1.0.0"
ENVIRONMENT="production" # "development" | "test" | "production"
DEBUG=false
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
STORAGE_DIR="uploads/resumes"

# Authentication & Security (CRITICAL: Set high-entropy unique keys in production)
SECRET_KEY="generate-a-secure-random-64-character-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Connection (Async PostgreSQL / pgvector recommended for production)
DATABASE_URL="postgresql+asyncpg://app_user:app_password@localhost:5432/job_assistant_prod"

# OmniRoute AI Gateway / LLM Orchestration
DEFAULT_AI_PROVIDER="omniroute" # "omniroute" | "openai" | "gemini" | "mock"
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_API_KEY="your-omniroute-api-key-here"
OMNIROUTE_CHAT_MODEL="gpt-4o"
OMNIROUTE_EMBEDDING_MODEL="text-embedding-3-small"
OMNIROUTE_TIMEOUT_SECONDS=60
OMNIROUTE_MAX_RETRIES=3

# Direct Fallback Providers (Optional)
OPENAI_API_KEY="sk-proj-your-openai-key-here"
GEMINI_API_KEY="your-gemini-key-here"
ANTHROPIC_API_KEY="your-anthropic-key-here"

# Google / Gmail OAuth Configuration (Phase 7)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://api.yourdomain.com/api/v1/mailbox/gmail/callback"

# Microsoft / Outlook OAuth Configuration (Phase 7)
MICROSOFT_CLIENT_ID="your-azure-ad-client-id"
MICROSOFT_CLIENT_SECRET="your-azure-ad-client-secret"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="https://api.yourdomain.com/api/v1/mailbox/outlook/callback"

# Mailbox Token Encryption Key (Fernet 32-byte urlsafe base64 key)
MAILBOX_ENCRYPTION_KEY="your-32-byte-fernet-encryption-key="
MAILBOX_SYNC_ENABLED=true
MAILBOX_INITIAL_SYNC_DAYS=90
MAILBOX_RETENTION_DAYS=180
MAILBOX_BODY_STORAGE="FULL_BODY"

# Rate Limiting & Worker Reliability
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
CONNECTOR_RATE_LIMIT_PER_MINUTE=30
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
AUDIT_LOGGING_ENABLED=true

# CORS Allowed Origins (No wildcards in production)
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com", "https://yourdomain.com"]
